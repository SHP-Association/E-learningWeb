# ===================================
# 🗄️ DATABASE CONFIGURATION
# ===================================
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=shplearner
DJANGO_DB_USER=sandesh
DJANGO_DB_PASSWORD=password123
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432

# ===================================
# ⚙️ DJANGO SETTINGS
# ===================================
DJANGO_SECRET_KEY=django_dev_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_ROOT_URLCONF=X.urls

# ===================================
# 👤 DJANGO SUPERUSER (for automatic create)
# ===================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

# ===================================
# 📧 EMAIL SETTINGS
# ===================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=example@example.com
EMAIL_HOST_PASSWORD=examplepassword
DEFAULT_FROM_EMAIL=${EMAIL_HOST_USER}

# ===================================
# 🔐 SECURITY SETTINGS
# ===================================
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# ===================================
# 🌍 FRONTEND (VITE / REACT / VUE)
# ===================================
VITE_PORT=5173
VITE_HOST=0.0.0.0
VITE_API_URL=http://localhost:8001

# ===================================
# 🧩 FEATURE FLAGS
# ===================================
REACT_APP_FEATURE_X=True
REACT_APP_FEATURE_Y=False

# ===================================
# 🎨 JAZZMIN ADMIN CUSTOMIZATION
# ===================================
JAZZMIN_SITE_TITLE=SHP-Learner Admin
JAZZMIN_SITE_HEADER=SHP-Learner
JAZZMIN_SITE_BRAND=SHP-Learner
JAZZMIN_WELCOME_SIGN=Welcome to the SHP-Learner Administration Panel
JAZZMIN_COPYRIGHT=SHP-Learner Platform © 2025
JAZZMIN_DASHBOARD_THEME=flatly

# ===================================
# 🗂️ STATIC & MEDIA PATHS (optional, for CI/CD)
# ===================================
DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media

# ===================================
# 🕓 LOCALIZATION
# ===================================
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC
