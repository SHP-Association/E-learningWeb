# -------------------------------
# Backend / Django
# -------------------------------

# PostgreSQL settings
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=shplearner_dev
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=postgres
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# Django superuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

# MySQL settings (if needed)
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=shplearner_mysql_dev
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Django settings
DJANGO_SECRET_KEY=django_dev_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional email settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=example@example.com
EMAIL_HOST_PASSWORD=examplepassword

# -------------------------------
# Frontend / React Vite
# -------------------------------

# Vite dev server port
VITE_PORT=5173
VITE_HOST=0.0.0.0

# API URL
VITE_API_URL=http://localhost:8000

# Optional frontend feature flags
REACT_APP_FEATURE_X=true
REACT_APP_FEATURE_Y=false
