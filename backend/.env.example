# Backend runtime environment
# Every key maps to config fields via Viper:
# <SECTION>_<FIELD>, nested fields continue with underscores.

HTTP_HOSTNAME=
HTTP_PORT=8000
HTTP_READTIMEOUT=5s
HTTP_WRITETIMEOUT=10s
HTTP_IDLETIMEOUT=2m
HTTP_SHUTDOWNTIMEOUT=10s
HTTP_TLS_ENABLED=false
HTTP_TLS_CERTIFICATE=
HTTP_TLS_KEY=

APP_NAME=Pagoda
APP_HOST=http://localhost:8000
APP_ENVIRONMENT=local
APP_ENCRYPTIONKEY=change-this-in-real-env
APP_TIMEOUT=20s
APP_PASSWORDTOKEN_EXPIRATION=60m
APP_PASSWORDTOKEN_LENGTH=64
APP_EMAILVERIFICATIONTOKENEXPIRATION=12h

CACHE_CAPACITY=100000
CACHE_EXPIRATION_PUBLICFILE=4380h

DATABASE_DRIVER=postgres
DATABASE_CONNECTION=host=localhost port=5434 user=postgres password=postgres dbname=shp_db sslmode=disable
DATABASE_TESTCONNECTION=file:/$RAND?vfs=memdb&_timeout=1000&_fk=true

FILES_DIRECTORY=uploads

TASKS_GOROUTINES=1
TASKS_RELEASEAFTER=15m
TASKS_CLEANUPINTERVAL=1h
TASKS_SHUTDOWNTIMEOUT=10s

MAIL_HOSTNAME=localhost
MAIL_PORT=25
MAIL_USER=admin
MAIL_PASSWORD=admin
MAIL_FROMADDRESS=admin@localhost
