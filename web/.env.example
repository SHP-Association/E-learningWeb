# SHP-Learner Frontend Environment Variables Example
# Copy this file to '.env' or '.env.local' in this directory and adjust the values.

# 1. Backend URL API Target (Default local development Go backend)
VITE_APP_BACKEND_URL=http://localhost:8000

# 2. Frontend Base URL for Canonical links and dynamic SEO Open Graph tags
VITE_APP_BASE_URL=http://localhost:5173
