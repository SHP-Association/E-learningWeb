# =========================
# 🌐 BACKEND API CONFIGURATION
# =========================
# Django backend URL (where your Django server is running)
VITE_APP_BACKEND_URL=http://localhost:8000

# Base URL for your frontend (used for SEO canonical URLs)
VITE_APP_BASE_URL=http://localhost:5173

# =========================
# 🎨 BRANDING & METADATA
# =========================
VITE_APP_NAME=SHP-Learner
VITE_APP_DESCRIPTION=Your one-stop destination for online learning
VITE_APP_KEYWORDS=e-learning,online courses,education,training

# =========================
# 📝 NOTES FOR DEVELOPMENT
# =========================
# These environment variables are used by the Vue frontend
# Make sure the backend is running on http://localhost:8000
# 
# To start the backend:
#   cd backend
#   python manage.py runserver
#
# To start the frontend:
#   cd web
#   npm run dev
#
# =========================
# 📝 NOTES FOR PRODUCTION
# =========================
# Before deploying to production:
# 1. Update VITE_APP_BACKEND_URL to your production API URL (e.g., https://api.shp-learner.com)
# 2. Update VITE_APP_BASE_URL to your production frontend URL (e.g., https://shp-learner.com)
# 3. Update branding information as needed
# 4. Build the frontend: npm run build
# 5. Deploy the dist/ folder to your hosting service